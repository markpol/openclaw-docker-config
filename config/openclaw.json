{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "loopback",
    "auth": {
      "allowTailscale": true
    },
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    },
    "controlUi": {
      "allowInsecureAuth": false,
      "allowedOrigins": [
	      "http://localhost:18789",
        "http://openclaw-prod:18789",
        "https://openclaw-prod.${TAILSCALE_DOMAIN}"
      ]
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "${TELEGRAM_BOT_TOKEN}",
      "dmPolicy": "pairing",
      "groupPolicy": "allowlist",
      "streaming": {
        "mode": "partial"
      }
    }
  },
  "plugins": {
    "entries": {
      "bonjour": {
        "enabled": false
      },
      "talk-voice": {
        "enabled": false
      },
      "phone-control": {
        "enabled": false
      },
      "telegram": {
        "enabled": true
      },
      "vercel-ai-gateway": {
        "enabled": true
      },
      "memory-core": {
        "config": {
          "dreaming": {
            "enabled": true
          }
        }
      },
      "memory-wiki": {
        "enabled": true
      }
    }
  },
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace/main",
      "model": {
        "primary": "vercel-ai-gateway/xai/grok-4-fast-reasoning",
        "fallbacks": [
          "vercel-ai-gateway/minimax/minimax-m2.5",
          "vercel-ai-gateway/deepseek/deepseek-v4-flash",
          "vercel-ai-gateway/alibaba/qwen3.5-flash"
        ]
      },
      "compaction": {
        "mode": "default",
        "reserveTokensFloor": 24000,
        "keepRecentTokens": 50000,
        "notifyUser": true,
        "memoryFlush": {
          "enabled": true,
          "softThresholdTokens": 6000,
          "systemPrompt": "Session nearing compaction. Store durable memories now.",
          "prompt": "Write any lasting notes to memory/YYYY-MM-DD.md; reply with the exact silent token NO_REPLY if nothing to store."
        }
      },
      "heartbeat": {
        "every": "4h"
      },
      "contextPruning": {
        "mode": "cache-ttl",
        "ttl": "4h",
        "keepLastAssistants": 50,
        "softTrimRatio": 0.3,
        "hardClearRatio": 0.5,
        "minPrunableToolChars": 5000,
        "softTrim": { "maxChars": 500, "headChars": 50, "tailChars": 50 },
        "hardClear": { "enabled": true, "placeholder": "[Old tool result content cleared]" },
        "tools": { "deny": ["browser", "canvas"] }
      },
      "maxConcurrent": 2,
      "subagents": {
        "maxConcurrent": 4
      }
    }
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto"
  },
  "messages": {
    "ackReactionScope": "group-mentions"
  },
  "logging": {
    "level": "info",
    "consoleLevel": "info",
    "redactSensitive": "tools"
  },
  "auth": {
    "profiles": {
      "vercel-ai-gateway:default": {
        "provider": "vercel-ai-gateway",
        "mode": "api_key"
      }
    }
  },
  "hooks": {
    "enabled": true,
    "path": "/hooks",
    "token": "${OPENCLAW_HOOKS_TOKEN}",
    "allowedAgentIds": ["main"]
  },
  "cron": {
    "enabled": true
  }
}