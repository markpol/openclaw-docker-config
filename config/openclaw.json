{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "loopback",
    "auth": {
      "allowTailscale": true
    },
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    },
    "controlUi": {
      "allowInsecureAuth": false,
      "allowedOrigins": [
        "http://localhost:18789",
        "http://${REMOTE_SERVER_IP}:18789",
        "http://openclaw-prod:18789",
        "https://openclaw-prod.${TAILSCALE_DOMAIN}"
      ]
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "${TELEGRAM_BOT_TOKEN}",
      "dmPolicy": "pairing",
      "groupPolicy": "allowlist",
      "streaming": {
        "mode": "partial"
      }
    }
  },
  "plugins": {
    "enabled": true,
    "allow": [
      "telegram",
      "vercel-ai-gateway",
      "lobster"
    ],
    "entries": {
      "telegram": {
        "enabled": true
      },
      "vercel-ai-gateway": {
        "enabled": true
      },
      "lobster": {
        "enabled": true
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "vercel-ai-gateway/google/gemini-3.1-flash-lite-preview",
        "fallbacks": [
          "vercel-ai-gateway/xai/grok-4.3",
          "vercel-ai-gateway/xai/grok-4.1-fast-reasoning",
          "vercel-ai-gateway/minimax/minimax-m2.5",
          "vercel-ai-gateway/deepseek/deepseek-v4-pro",
          "vercel-ai-gateway/deepseek/deepseek-v4-flash",
          "vercel-ai-gateway/alibaba/qwen3.6-27b",
          "vercel-ai-gateway/alibaba/qwen3.5-flash",
          "vercel-ai-gateway/xiaomi/mimo-v2.5",
          "vercel-ai-gateway/moonshotai/kimi-k2.6",
          "vercel-ai-gateway/zai/glm-5.1"
        ]
      },
      "heartbeat": {
        "every": "4h"
      },
      "maxConcurrent": 2,
      "subagents": {
        "maxConcurrent": 4
      },
      "models": {
        "vercel-ai-gateway/*": {}
      },
      "skills": []
    },
    "list": [
      {
        "id": "pm",
        "workspace": "~/.openclaw/workspace-pm",
        "tools": {
          "alsoAllow": [
            "lobster"
          ]
        }
      }
    ]
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto"
  },
  "messages": {
    "ackReactionScope": "group-mentions"
  },
  "logging": {
    "level": "info",
    "consoleLevel": "info",
    "redactSensitive": "tools"
  },
  "auth": {
    "profiles": {
      "vercel-ai-gateway:default": {
        "provider": "vercel-ai-gateway",
        "mode": "api_key"
      }
    }
  },
  "hooks": {
    "enabled": true,
    "path": "/hooks",
    "token": "${OPENCLAW_HOOKS_TOKEN}",
    "defaultSessionKey": "hook:ingress",
    "allowedSessionKeyPrefixes": [
      "hook:",
      "hook:pm:"
    ],
    "allowedAgentIds": [
      "pm"
    ],
    "mappings": [
      {
        "id": "github-pm",
        "match": {
          "path": "github-pm"
        },
        "action": "agent",
        "agentId": "pm",
        "sessionKey": "hook:pm:orchestrator",
        "wakeMode": "now",
        "messageTemplate": "Execute Lobster workflow for event: {{action}}\nPayload: {{payload_key}}={{payload_value}}",
        "thinking": "low",
        "deliver": true
      }
    ]
  },
  "cron": {
    "enabled": true
  },
  "meta": {
    "lastTouchedVersion": "2026.5.12",
    "lastTouchedAt": "2026-05-17T12:34:25.797Z"
  }
}
